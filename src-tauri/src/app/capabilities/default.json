{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main",
    "settings",
    "close-dialog"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask"
  ]
}