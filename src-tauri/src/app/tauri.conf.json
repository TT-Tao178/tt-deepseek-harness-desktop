{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TT DeepSeek Harness Desktop",
  "version": "0.4.3",
  "identifier": "com.tt.deepharness",
  "build": {
    "frontendDist": "./ui-stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../kernel/": "kernel/",
      "../../../plugins/": "plugins/",
      "../../../resources/installer/": "resources/installer/",
      "dlls/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "mainBinaryName": "tt-dsh-desktop"
}